rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Account Google autorizzati: per aggiungere un collega metti qui la sua
    // email (tutto minuscolo) e ripubblica le regole.
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'polammslorenzo@gmail.com'
           ];
    }

    // Registro Verbali: unica collection usata dalla pagina, solo per gli autorizzati
    match /elenco_verbali/{verbale} {
      allow read, delete: if autorizzato();
      allow create: if autorizzato()
        && request.resource.data.keys().hasOnly(CAMPI().concat(['createdAt']))
        && request.resource.data.createdAt == request.time
        && valori(request.resource.data);
      allow update: if autorizzato()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(CAMPI())
        && valori(request.resource.data);
    }
    // Tutto il resto è negato
    match /{document=**} {
      allow read, write: if false;
    }

    function CAMPI() {
      return ['tipo','denom','sede','verbale','data','norme','note'];
    }
    // Solo testo di lunghezza ragionevole, denominazione e numero obbligatori,
    // data AAAA-MM-GG o vuota
    function valori(d) {
      return testo(d, 'tipo', 60)
        && testo(d, 'denom', 300) && d.denom.size() > 0
        && testo(d, 'sede', 300)
        && testo(d, 'verbale', 60) && d.verbale.size() > 0
        && testo(d, 'norme', 300)
        && testo(d, 'note', 1000)
        && (!('data' in d) || d.data is string && (d.data == '' || d.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }
    function testo(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
  }
}
