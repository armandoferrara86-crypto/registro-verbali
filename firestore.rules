rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registro Verbali: dalla pagina si possono SOLO aggiungere verbali.
    // Lettura, modifica e cancellazione sono chiuse finché non c'è il login
    // con Google; il registro si consulta dalla console Firebase.
    match /elenco_verbali/{verbale} {
      allow create: if verbaleValido(request.resource.data);
      allow read, update, delete: if false;
    }
    // Tutto il resto è negato
    match /{document=**} {
      allow read, write: if false;
    }

    // Solo i campi del registro, solo testo di lunghezza ragionevole,
    // data AAAA-MM-GG (o vuota) e createdAt messo dal server.
    function verbaleValido(d) {
      return d.keys().hasOnly(['tipo','denom','sede','verbale','data','norme','note','createdAt'])
        && d.keys().hasAll(['denom','verbale','createdAt'])
        && d.createdAt == request.time
        && testo(d, 'tipo', 60)
        && testo(d, 'denom', 300) && d.denom.size() > 0
        && testo(d, 'sede', 300)
        && testo(d, 'verbale', 60) && d.verbale.size() > 0
        && testo(d, 'norme', 300)
        && testo(d, 'note', 1000)
        && (!('data' in d) || d.data is string && (d.data == '' || d.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }
    function testo(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
  }
}
